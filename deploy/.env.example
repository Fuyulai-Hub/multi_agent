# MySQL / Redis 存储层接入：.env 外注模板
# 复制为 .env 后填写真实密码（.env 已在 .gitignore 中，不会提交）：
#   cp deploy/.env.example deploy/.env
#
# 两个密码需与 config/credentials.yaml 的 store.mysql.password 保持一致
# （credentials.yaml 优先级更高，见 docs/28「三通道外注」）。

# MySQL root 密码（仅首次初始化数据卷 / 容器内排障用）
MAS_MYSQL_ROOT_PASSWORD=change-me-root

# mas 业务账号密码（runtime.store.mysql.password 的同款值；
# 生产建议改走环境变量 MAS_MYSQL_PASSWORD，则本文件可不填该项）
MAS_MYSQL_PASSWORD=change-me-mas
